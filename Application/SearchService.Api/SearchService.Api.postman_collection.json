{
	"info": {
		"name": "SearchService.Api",
		"description": "Requests for the OpenSearch-backed SearchService.Api dispatch endpoints (index, delete, search).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Dispatch",
			"item": [
				{
					"name": "Index dispatch",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const body = pm.response.json();",
									"if (body.id) {",
									"    pm.collectionVariables.set(\"dispatchId\", body.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dispatchId\": \"{{dispatchId}}\",\n  \"priceTotal\": 1500.50,\n  \"pickupDate\": \"2026-08-01T00:00:00Z\",\n  \"dropoffDate\": \"2026-08-05T00:00:00Z\",\n  \"dispatchStatus\": \"Delivered\",\n  \"vehicle\": {\n    \"vin\": \"1HGCM82633A004352\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/dispatch",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch" ]
						}
					}
				},
				{
					"name": "Index dispatch - invalid (400)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/dispatch",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch" ]
						}
					}
				},
				{
					"name": "Delete dispatch",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/{{dispatchId}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "{{dispatchId}}" ]
						}
					}
				},
				{
					"name": "Delete dispatch - repeat (404)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/{{dispatchId}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "{{dispatchId}}" ]
						}
					}
				}
			]
		},
		{
			"name": "Search",
			"item": [
				{
					"name": "Search by DispatchId (match)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/search?dispatchId={{dispatchId}}",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "search" ],
							"query": [
								{ "key": "dispatchId", "value": "{{dispatchId}}" }
							]
						}
					}
				},
				{
					"name": "Search by DispatchStatus + PriceTotal range",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/search?dispatchStatus=Delivered&priceTotalMin=1000&priceTotalMax=2000",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "search" ],
							"query": [
								{ "key": "dispatchStatus", "value": "Delivered" },
								{ "key": "priceTotalMin", "value": "1000" },
								{ "key": "priceTotalMax", "value": "2000" }
							]
						}
					}
				},
				{
					"name": "Search by PickupDate + DropoffDate range",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/search?pickupDateFrom=2026-07-01T00:00:00Z&pickupDateTo=2026-08-31T00:00:00Z&dropoffDateFrom=2026-07-01T00:00:00Z&dropoffDateTo=2026-08-31T00:00:00Z",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "search" ],
							"query": [
								{ "key": "pickupDateFrom", "value": "2026-07-01T00:00:00Z" },
								{ "key": "pickupDateTo", "value": "2026-08-31T00:00:00Z" },
								{ "key": "dropoffDateFrom", "value": "2026-07-01T00:00:00Z" },
								{ "key": "dropoffDateTo", "value": "2026-08-31T00:00:00Z" }
							]
						}
					}
				},
				{
					"name": "Search by Vehicle.Vin (partial, case-insensitive)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/search?vehicleVin=1hgcm82",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "search" ],
							"query": [
								{ "key": "vehicleVin", "value": "1hgcm82" }
							]
						}
					}
				},
				{
					"name": "Search - no filters (paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/search?page=1&pageSize=20",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "search" ],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "pageSize", "value": "20" }
							]
						}
					}
				},
				{
					"name": "Search - invalid range (400)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/dispatch/search?priceTotalMin=2000&priceTotalMax=1000",
							"host": [ "{{baseUrl}}" ],
							"path": [ "api", "dispatch", "search" ],
							"query": [
								{ "key": "priceTotalMin", "value": "2000" },
								{ "key": "priceTotalMax", "value": "1000" }
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://localhost:7036"
		},
		{
			"key": "dispatchId",
			"value": "11111111-1111-1111-1111-111111111111"
		}
	]
}
